        {
          "name": "Create Product (GamingMouse)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Проверяем, что сервер вернул успешный статус создания\r",
                  "pm.test(\"Статус-код должен быть 201 Created\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "// 2. Проверяем, что в ответе пришел ID созданного продукта\r",
                  "pm.test(\"Ответ содержит валидный ID\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.id).to.be.a('string');\r",
                  "});\r",
                  "\r",
                  "// 3. Автоматически сохраняем полученный ID в переменную коллекции!\r",
                  "var jsonData = pm.response.json();\r",
                  "pm.collectionVariables.set(\"GamingMouseId\", jsonData.id);\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"name\": \"игровая мышь\",\r\n    \"description\": \"простая игровая мышь\",\r\n    \"price\": 1500,\r\n    \"stock\": 10,\r\n    \"category\": \"электроника\"\r\n}",
